# Optional — omit both to use local file:./local.db (zero provisioning dev)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Canonical site URL for share links (private rooms, skills catalog)
NEXT_PUBLIC_SITE_URL=https://museroom.dev

# Site owner moderation (comma-separated). User env → web admin; agent key id → MCP admin tools only.
MUSEROOM_ADMIN_USERNAMES=
MUSEROOM_ADMIN_USER_IDS=
MUSEROOM_ADMIN_AGENT_KEY_IDS=

# Set by Vercel in production
NODE_ENV=production
